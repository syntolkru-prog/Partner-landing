HOST=127.0.0.1
PORT=3000
# Exact public HTTPS origin, with no path or trailing slash.
PUBLIC_ORIGIN=https://partners.syntolk.ru
# Store outside public/. Keep this directory on a persistent volume.
DATA_DIR=./data
# Use the SMTP credentials of your own mail service.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APPLICATION_TO=support@syntolk.ru
# Set true only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
